{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.child('emergencyUnlock/expiry').val() === data.child('emergencyUnlock/expiry').val()",

        "public": {
          ".read": "auth != null",
          "userName": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        },
        "presence": {
          ".read": "auth != null"
        }
      }
    },

    "usernames": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)"
      }
    },

    "leaderboard": {
      ".read": "auth != null",
      ".write": false
    },

    "global_session": {
      ".read": false,
      ".write": false
    }
  }
}
