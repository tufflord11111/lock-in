{
  "$schema": "../../gen/schemas/desktop-schema.json",
  "identifier": "parrot",
  "description": "Parrot overlay: its own events and the companion commands it uses, nothing else",
  "windows": [
    "parrot"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit-to",
    "allow-companion-ready",
    "allow-companion-set-hitbox",
    "allow-companion-set-dragging",
    "allow-companion-state",
    "allow-companion-log-menu"
  ]
}
